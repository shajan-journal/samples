# Evaluation Database Connection (Neon PostgreSQL)
# Get this from your team or Neon dashboard
EVAL_DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Context Engine Eval Directory (where the python eval code lives)
CONTEXT_ENGINE_EVAL_DIR="/path/to/context-engine/context-engine/python/eval"

# Journal API Configuration (for triggering runs)
JOURNAL_API_URL="http://localhost:3001"

# Session cookie from browser DevTools > Application > Cookies
# Required to trigger evaluation runs
JOURNAL_COOKIE="journal.session_token=XXX"

# Optional: Neon branch reset configuration
NEON_API_KEY=""
NEON_PROJECT_ID=""
NEON_BRANCH_ID=""

# Default eval settings
DEFAULT_MODEL="claude-opus-4-5"
DEFAULT_PROMPT_TYPE="lean"
